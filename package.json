{
  "name": "hoshino-fortune",
  "packageManager": "bun@1.3.6",
  "private": true,
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "bun run --cwd apps/backend db:seed && playwright test",
    "test:e2e:api": "bun run --cwd apps/backend db:seed && playwright test --project=api",
    "test:all": "vitest run && bun run test:e2e"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.1",
    "next": "^16.1.6",
    "turbo": "latest",
    "vite-tsconfig-paths": "^6.0.5",
    "vitest": "^4.0.18"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
